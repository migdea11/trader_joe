SERVICE_WORKERS=1
EXECUTOR_THREADS=4

# Alpaca handle settings. Each may only lower or tune what the code hard-codes.
#
# Alpaca calls per minute; may only lower the hard-coded ceiling of 200.
ALPACA_RATE_LIMIT_PER_MINUTE=200
# Unacknowledged attempt reports held before the handle stops taking work from its queue.
ALPACA_OUTGOING_BUFFER_SIZE=64
# Seconds the oldest unacknowledged report may wait before the stall alarm.
ALPACA_STALL_TIMEOUT_S=300
# Attempts one request gets, the first included.
ALPACA_MAX_ATTEMPTS=5

# User Secrets
#
# These are your Alpaca API credentials. Make sure to keep them safe!
# ALPACA_API_KEY="<YOUR_API_KEY>"
# ALPACA_API_SECRET="<YOUR_API_SECRET>"

