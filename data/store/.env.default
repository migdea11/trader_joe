# Postgres Config
#
# DATABASE_URI is deliberately not set here. Exactly one thing consumes it --
# migrations/env.py, which hands it to alembic as sqlalchemy.url -- and under compose
# docker-compose.yaml sets it in the data_store service's `environment:` block, which
# takes precedence over `env_file:`. The app itself never reads it; database.py builds
# its own DSN from DATABASE_NAME/DATABASE_PORT/POSTGRES_DB_NAME/POSTGRES_USER/POSTGRES_PASS.
#
# The line that used to live here was dead and wrong on two counts (tj-70ovb3): it
# interpolated DATABASE_USER/DATABASE_PASS, which nothing in this repo defines, and it
# used DATABASE_NAME as both the host and the database name. Compose interpolates
# unquoted env_file values, so this file -- loaded by the postgres and data_store
# services alike -- made every launch warn that both names were unset, and would have
# yielded postgresql://:@db:5432/db the day someone deleted the compose override
# believing this file had it covered. One definition, in compose, is the point.
#
# To run alembic OUTSIDE compose, uncomment and fill in. Note this form dials the host
# side of the postgres port mapping (DATABASE_PORT), not the container's 5432:
# DATABASE_URI=postgresql://<POSTGRES_USER>:<POSTGRES_PASS>@localhost:<DATABASE_PORT>/<POSTGRES_DB_NAME>
DATABASE_CONN_TIMEOUT=120
POSTGRES_ASYNC=true

# Data Apps
SERVICE_WORKERS=1
EXECUTOR_THREADS=4

# Rows per multi-row INSERT ... ON CONFLICT on the bar write path (decision tj-vz1eta item 2).
# 1000, up from 10: ten-row statements turn one page of a backfill into hundreds of round trips.
# The resolver's clamp stays the safety net -- _resolve_chunk_size
# (data/store/app/database/crud/stock/asset_market_activity.py) caps whatever is set here at what
# asyncpg's argument limit allows, derived from the table's own column list. 1000 sits well below
# it, so the clamp never fires here and never warns; the per-write DEBUG line is what makes the
# effective size visible.
MARKET_ACTIVITY_BATCH_SIZE=1000