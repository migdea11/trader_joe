SERVICE_WORKERS=1
EXECUTOR_THREADS=4

BROKER_CONN_TIMEOUT=120

# Per-vendor rate budget (tj-84ty47 section 5). Sized BELOW the vendor's documented limit,
# and configured here rather than hard-coded because the numbers differ per vendor and
# Alpaca's is still unconfirmed (tj-3mk3u5.2) -- the value below is provisional and
# deliberately conservative. Leaving ALPACA_RATE_LIMIT_PER_SEC unset disables the budget
# entirely rather than throttling at a number nobody has verified.
#
# BACKFILL_RESERVE is the anti-thrash rule: those tokens are spendable by live and
# interactive calls only, so history never crowds out the live path.
ALPACA_RATE_LIMIT_PER_SEC=3
ALPACA_RATE_BURST=3
ALPACA_BACKFILL_RESERVE=1.5

# User Secrets
#
# These are your Alpaca API credentials. Make sure to keep them safe!
# ALPACA_API_KEY="<YOUR_API_KEY>"
# ALPACA_API_SECRET="<YOUR_API_SECRET>"

