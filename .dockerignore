# Docker. The root compose file, every docker-compose.*.yaml beside it, and the devcontainer.
docker-compose.yaml
docker-compose.*.yaml
.devcontainer/
Dockerfile
.dockerignore

# Environments. These hold live credentials -- server/data/ingest/.env carries the Alpaca API
# key -- and nothing in the image reads them: compose supplies configuration at runtime
# via env_file:. Keeping them out of the build context means a stray COPY cannot pick
# one up either. .env.default is committed and harmless, so it is not excluded.
.env
**/.env

# Host bind-mount data (tj-ijpys9.17). Every host data directory compose declares sits under
# ${DATA_DIR:-./volume_data}: postgres in docker-compose.yaml, pgadmin in
# docker-compose.tools.yaml. .env.default sets DATA_DIR=./volumes/trader_joe/, and the fallback
# is ./volume_data. The Postgres directory is mode 0700 and owned by the container's uid, so a
# build started while a stack is up -- make test-system's --build, in CI after Start System --
# fails sending the context with "permission denied". Nothing in the image reads them anyway.
volumes/
volume_data/

# Agent git worktrees (tj-aov3ip): whole extra copies of the repo, and half-edited ones
.claude/worktrees/

# Virtual environment
.venv/
.venv-devcontainer/
.venv_init

# Byte-compiled / optimized / DLL files
**/__pycache__/
**/*.py[cod]

# C extensions
*.so

# Test directories under the Dockerfile's COPY roots (tj-v82dvm). The image copies
# server/common/, server/routers/ and server/schemas/ whole, so without these their suites ship in
# every service image. No production module imports them (decision tj-j4wknb R4). The top-level
# tests/ is never copied.
# These are BUILD-CONTEXT paths, so they carry the server/ prefix the COPY sources carry (epic
# tj-iontkq, R-2): a rule that still read common/tests/ would match nothing and fail silently --
# the suites would simply start shipping again with every check still green.
server/common/tests/
server/routers/tests/
server/schemas/tests/

# The three root siblings that are not server code (tj-iontkq.1). Every service build sets
# context: . -- docker-compose.yaml for both services, plus docker-compose.test-client.yaml and
# docker-compose.agent-mcp.yaml -- so anything here is uploaded to the daemon on every build, and
# that is the whole cost: web/ grows node_modules and client/ grows build artefacts and a .venv.
# Nothing in a service image reads any of the three. proto/ is the hand-written contract source;
# what the image needs is protoc's OUTPUT, and it gets exactly that from one COPY of
# ./gen/proto/python (Dockerfile), which is deliberately NOT excluded here. That tree is generated
# and never committed, so the build targets run `make proto` on the host first -- the Dockerfile is
# unchanged by that, and generating in-image would put grpcio-tools in the prod image (the Makefile's
# proto block has the measurement).
web/
client/
proto/

# Unit test / coverage reports
.pytest_cache/
.ruff_cache/
.coverage
pytest.ini
coverage.xml

# VS Code
.vscode/
*.code-workspace

# Misc
Makefile
README.md
