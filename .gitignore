# vsCode
*.code-workspace
.vscode/

# Environments
.env
.venv/
# The devcontainer's own environment (UV_PROJECT_ENVIRONMENT, tj-3t2axg), kept apart from the
# host's .venv because /workspace is the host checkout bind-mounted in.
.venv-devcontainer/
.python-version

# Make. The sync marker now lives inside the environment; .venv_init is the pre-tj-3t2axg
# spelling, still ignored because old checkouts carry one.
.venv_init

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Testing
.coverage
coverage.xml
.ruff_cache/
.pytest_cache/

# Container volume mounts (DATA_DIR in .env, and the compose fallback).
# Root-owned by the container; must never be committable, and ruff/pytest
# cannot traverse it either.
/volumes/
/volume_data/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Scratch output from the prepare-pr skill
.claude/publish/

# Per-machine Claude Code settings: local permission overrides, never shared
/.claude/settings.local.json

# Agent git worktrees (tj-aov3ip): each is a separate checkout, never content of this one
/.claude/worktrees/
