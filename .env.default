DATA_DIR=./volumes/trader_joe/
PYTHONPATH=./

# Postgres Config
DATABASE_NAME=db
DATABASE_PORT=5432
POSTGRES_DB_NAME=postgres
POSTGRES_USER=postgres
# Required, no default. Compose refuses to start while this is empty rather than
# standing up a database with a password that is published in this file. Generate one:
#   echo "POSTGRES_PASS=$(openssl rand -hex 24)" >> .env
# Hex, not base64: this lands unencoded in DATABASE_URI, where a '/' splits it for RFC 3986 parsers.
POSTGRES_PASS=
POSTGRES_UI_PORT=5431

# pgAdmin (docker-compose.tools.yaml, `make dev-tools` only). Required there, no default;
# the password must be 6+ characters. No other target needs these.
PGADMIN_EMAIL=
PGADMIN_PASS=

# Kafka Config
BROKER_NAME=kafka
BROKER_PORT=9092
KAFKA_ID=db1d7383-a2a4-412c-b955-3f8281a32c7c


# Data Apps
APP_INTERNAL_PORT=80
# Where debugpy binds inside the container when RUN_MODE=dev. Loopback by default: the
# debugger executes arbitrary code in the process. Attaching from the host needs 0.0.0.0
# here AND a published debug port in docker-compose.override.yaml -- neither compose file
# publishes one today, so DATA_STORE_DEBUG_PORT/DATA_INGEST_DEBUG_PORT below are unused.
APP_INTERNAL_DEBUG_HOST=127.0.0.1
APP_INTERNAL_DEBUG_PORT=5678
DATA_STORE_NAME=data_store
DATA_STORE_PORT=8080
DATA_STORE_DEBUG_PORT=9080
DATA_INGEST_NAME=data_ingest
DATA_INGEST_PORT=8081
DATA_INGEST_DEBUG_PORT=9081

# Misc
# The latency harness (routers/common/latency.py). Off here because this file is what every
# environment -- prod and CI included -- is copied from, and the cost is paid whether or not the
# endpoint is ever called: when it is on, data_store and data_ingest both create the latency Kafka
# topics and their RPC client/server consumers at startup. Calling GET /latency on data_store then
# builds a random payload_size KB payload, hex-encodes it so it doubles on the wire, and sends it
# to data_ingest `iterations` times. Turned back on for dev only, in docker-compose.override.yaml,
# which PROD_COMPOSE never loads -- so `make dev-launch` still has the harness for tj-3mk3u5.8.
LATENCY_TEST_ENABLED=false
LATENCY_TEST_TIMEOUT=60
